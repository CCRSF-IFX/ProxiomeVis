#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${PROXIOME_APP_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
RSCRIPT_BIN="${PROXIOME_RSCRIPT:-Rscript}"

if ! command -v "${RSCRIPT_BIN}" >/dev/null 2>&1; then
  echo "Rscript not found: ${RSCRIPT_BIN}. Set PROXIOME_RSCRIPT to your R executable." >&2
  exit 1
fi
if [[ ! -f "${APP_DIR}/app.R" ]]; then
  echo "app.R not found in ${APP_DIR}. Set PROXIOME_APP_DIR to this R checkout." >&2
  exit 1
fi

export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export SHINY_HOST="${SHINY_HOST:-0.0.0.0}"
export PROXIOME_PORT="${port:-${PORT:-${PORT1:-3839}}}"

cd "${APP_DIR}"
exec "${RSCRIPT_BIN}" --vanilla -e \
  'shiny::runApp(".", host = Sys.getenv("SHINY_HOST"), port = as.integer(Sys.getenv("PROXIOME_PORT")))'
